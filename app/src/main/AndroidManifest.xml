<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- DG-025: the sleep timer is not playback. specialUse (API 34+) plus a
         subtype property documents that it only lowers the shared media volume. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Runtime permission on API 33+. Denial only hides the notification; the
         timer still runs and the in-app card can still cancel it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No network, storage, or microphone permission is needed: the app only
         renders local DSP audio and a bundled loop, and adjusts the shared
         STREAM_MUSIC volume through public AudioManager APIs (no permission). -->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DreamGuard">

        <service android:name=".audio.PlaybackService" android:foregroundServiceType="mediaPlayback" android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- DG-025: independent, non-exported timer service. Started only from a
             visible user action; START_NOT_STICKY and no boot receiver. -->
        <service
            android:name=".audio.SleepTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="sleep timer that only lowers the shared media volume; no audio playback or capture" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DreamGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
